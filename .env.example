# ---------------------------------------------------------------------------
# Aquisiteur configuration. Copy to `.env` for `next dev`, to `.dev.vars` for
# `wrangler dev`, and set the same names as Worker secrets/vars in production
# (see docs/DEPLOY.md). Workspace data (names, phone numbers, imprint …) never
# goes here; it lives in the database (workspace_settings).
# ---------------------------------------------------------------------------

# Hosting profile: `node` (next dev / next start / any Node host) or
# `cloudflare` (Workers via OpenNext, DB through the HYPERDRIVE binding).
HOSTING_PROFILE=node

# Postgres. Profile `node`: always used. Profile `cloudflare`: only a fallback
# when no HYPERDRIVE binding exists. Migrations always use it.
# Local:     postgres://aquisiteur:aquisiteur@localhost:5432/aquisiteur
# Supabase:  postgres://postgres.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgres://aquisiteur:aquisiteur@localhost:5432/aquisiteur

# Disposable database for `pnpm test:db` (it gets wiped on every run).
TEST_DATABASE_URL=postgres://aquisiteur:aquisiteur@localhost:5432/aquisiteur_test

# Origin of the cockpit. Its host is the cockpit; every other host is a
# workspace's public site.
APP_URL=http://localhost:3000

# Workspaces get <slug>.<PLATFORM_DOMAIN> as fallback host for exposés.
# Local: `localhost` (browsers resolve *.localhost to 127.0.0.1).
PLATFORM_DOMAIN=localhost

# At least 32 random characters: `openssl rand -base64 48`
BETTER_AUTH_SECRET=change-me-change-me-change-me-change-me

# Comma-separated emails allowed to create an account (no public sign-up in v1).
SIGNUP_ALLOWLIST=owner@example.com

# Mail: `log` prints mails (incl. magic links) to the server log (dev only),
# `resend` sends via Resend (EU region).
EMAIL_PROVIDER=log
EMAIL_FROM="Aquisiteur <noreply@example.com>"
RESEND_API_KEY=

# 32 random bytes, base64: `openssl rand -base64 32`. Encrypts per-workspace
# integration secrets (e.g. the Pingen API key) in the database.
INTEGRATIONS_ENCRYPTION_KEY=

# Seed script (`pnpm db:seed`): owner account of the demo workspace.
SEED_OWNER_EMAIL=owner@example.com

# File storage for exposé images and videos. `local` writes to LOCAL_STORAGE_DIR
# (dev and tests only); `s3` talks to any S3-compatible store (Cloudflare R2,
# Supabase Storage, MinIO). For R2: S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=.data/storage
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# Live chat and live feed. `memory` streams Server-Sent Events from this process
# (dev, tests, one Node instance). On Cloudflare Workers use `supabase`:
# Project URL plus the publishable key (sent to browsers) and the secret key
# (server only) from Supabase → Project Settings → API Keys.
REALTIME_PROVIDER=memory
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# CLI (`pnpm expose:publish`): token from Settings → API tokens, and the
# cockpit origin to publish to (defaults to APP_URL).
AQUISITEUR_API_TOKEN=
AQUISITEUR_API_URL=

# Owner notifications (§7.7). `log` prints pushes; `webpush` needs a VAPID key
# pair: run `pnpm push:keys` once and keep the private key secret.
PUSH_PROVIDER=log
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Bearer secret for /api/jobs/hourly (daily digest). At least 24 characters.
CRON_SECRET=

# Map positions (§7.8): `nominatim` (OpenStreetMap, one request per second from
# the hourly job), `fake` (deterministic test points) or `none`.
GEOCODER_PROVIDER=nominatim
# Contact address sent to Nominatim, as its usage policy asks.
GEOCODER_CONTACT=you@example.com
