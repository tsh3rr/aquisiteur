                  "required": [
                    "title",
                    "description"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "id",
              "type",
              "title",
              "steps"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{1,47}$",
                "description": "Stable id of the block, unique within the exposé. Tracking keys on it."
              },
              "type": {
                "type": "string",
                "const": "pricing"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "intro": {
                "type": "string",
                "maxLength": 800
              },
              "currency": {
                "default": "EUR",
                "type": "string",
                "const": "EUR"
              },
              "vatNote": {
                "default": "Alle Preise netto zzgl. gesetzlicher USt.",
