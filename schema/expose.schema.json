                    },
                    "caption": {
                      "type": "string",
                      "maxLength": 300
                    }
                  },
                  "required": [
                    "src",
                    "alt"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "id",
              "type",
              "title",
              "images"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{1,47}$",
                "description": "Stable id of the block, unique within the exposé. Tracking keys on it."
              },
              "type": {
                "type": "string",
