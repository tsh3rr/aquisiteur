                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]{1,47}$",
                      "description": "Stable id of the option, unique within the block."
                    },
                    "title": {
