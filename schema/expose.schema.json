{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "prospect": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,58}[a-z0-9]$",
          "description": "Stable key of the prospect in this workspace, e.g. 'cafe-mueller'. Publishing again with the same key creates a new version of the same exposé."
        },
        "company": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "industry": {
          "type": "string",
          "maxLength": 80
        },
        "website": {
          "type": "string",
          "maxLength": 300,
          "format": "uri"
        },
        "contact": {
          "type": "object",
          "properties": {
            "salutation": {
              "default": "",
              "type": "string",
              "enum": [
                "Frau",
                "Herr",
                ""
              ]
            },
            "firstName": {
              "type": "string",
              "maxLength": 80
            },
            "lastName": {
              "type": "string",
              "maxLength": 80
            },
            "role": {
              "type": "string",
              "maxLength": 80
            }
          },
          "additionalProperties": false
        },
        "address": {
          "type": "object",
          "properties": {
            "street": {
              "type": "string",
              "maxLength": 160
            },
            "postalCode": {
              "type": "string",
              "maxLength": 10
            },
            "city": {
              "type": "string",
              "maxLength": 120
            },
            "country": {
              "default": "DE",
              "type": "string",
              "minLength": 2,
              "maxLength": 2
            }
          },
          "additionalProperties": false
        },
        "phone": {
          "type": "string",
          "maxLength": 40
        },
        "email": {
          "type": "string",
          "maxLength": 254,
          "format": "email",
          "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
        }
      },
      "required": [
        "key",
        "company"
      ],
      "additionalProperties": false,
      "description": "Created in the cockpit on first publish. Later publishes do not overwrite data edited in the cockpit."
    },
    "meta": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Browser tab title, e.g. 'Vorschläge für Café Müller'."
        },
        "description": {
          "type": "string",
          "maxLength": 300
        },
        "lang": {
          "default": "de",
          "type": "string",
          "enum": [
            "de",
            "en"
          ]
        }
      },
      "required": [
        "title"
      ],
      "additionalProperties": false
    },
    "theme": {
      "default": {},
      "type": "object",
      "properties": {
        "accent": {
          "description": "Accent colour of the prospect's brand. Adjusted automatically when contrast is too low.",
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "logo": {
          "description": "Logo of the prospect, shown in the header.",
          "type": "object",
          "properties": {
            "src": {
              "type": "string",
              "pattern": "^assets\\/(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._/-]*\\.(png|jpe?g|webp|avif|svg|mp4|webm|vtt)$",
              "description": "Relative path, e.g. assets/vorher.png"
            },
            "alt": {
              "type": "string",
              "maxLength": 300,
              "description": "What the image shows. Empty string only for purely decorative images."
            },
            "caption": {
              "type": "string",
              "maxLength": 300
            }
          },
          "required": [
            "src",
            "alt"
          ],
          "additionalProperties": false
        },
        "appearance": {
          "default": "auto",
          "type": "string",
          "enum": [
            "auto",
            "light",
            "dark"
          ]
        }
      },
      "additionalProperties": false
    },
    "letter": {
      "description": "Text for the printed letter (phase 5).",
      "type": "object",
      "properties": {
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "description": "Markdown subset: blank line = new paragraph, **bold**, *italic*, [text](https://…), lines starting with '- ' form a list."
        }
      },
      "required": [
        "subject",
        "body"
      ],
      "additionalProperties": false
    },
    "blocks": {
      "minItems": 1,
      "maxItems": 40,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{1,47}$",
                "description": "Stable id of the block, unique within the exposé. Tracking keys on it."
              },
              "type": {
                "type": "string",
                "const": "hero"
              },
              "eyebrow": {
                "description": "Small line above the greeting, e.g. 'Für Café Müller'.",
                "type": "string",
                "maxLength": 80
              },
              "greeting": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "description": "Personal salutation, e.g. 'Hallo Frau Müller,'."
              },
              "headline": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "lead": {
                "type": "string",
                "maxLength": 600
              },
              "image": {
                "description": "Optional large image, e.g. a mockup of the new site.",
                "type": "object",
                "properties": {
                  "src": {
                    "type": "string",
                    "pattern": "^assets\\/(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._/-]*\\.(png|jpe?g|webp|avif|svg|mp4|webm|vtt)$",
                    "description": "Relative path, e.g. assets/vorher.png"
                  },
                  "alt": {
                    "type": "string",
                    "maxLength": 300,
                    "description": "What the image shows. Empty string only for purely decorative images."
                  },
                  "caption": {
                    "type": "string",
                    "maxLength": 300
                  }
                },
                "required": [
                  "src",
                  "alt"
                ],
                "additionalProperties": false
              },
              "showOwnerPhoto": {
                "default": true,
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "type",
              "greeting",
              "headline"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{1,47}$",
                "description": "Stable id of the block, unique within the exposé. Tracking keys on it."
              },
              "type": {
                "type": "string",
                "const": "personal_note"
              },
              "title": {
                "type": "string",
                "maxLength": 120
              },
              "body": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000,
                "description": "Markdown subset: blank line = new paragraph, **bold**, *italic*, [text](https://…), lines starting with '- ' form a list."
              },
              "showSignature": {
                "default": true,
                "type": "boolean"
              },
              "video": {
                "type": "object",
                "properties": {
                  "src": {
                    "type": "string",
                    "pattern": "^assets\\/(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._/-]*\\.(png|jpe?g|webp|avif|svg|mp4|webm|vtt)$"
                  },
                  "captions": {
                    "type": "string",
                    "pattern": "^assets\\/(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._/-]*\\.(png|jpe?g|webp|avif|svg|mp4|webm|vtt)$",
                    "description": "WebVTT captions are required."
                  },
                  "poster": {
                    "type": "object",
                    "properties": {
                      "src": {
                        "type": "string",
                        "pattern": "^assets\\/(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._/-]*\\.(png|jpe?g|webp|avif|svg|mp4|webm|vtt)$",
                        "description": "Relative path, e.g. assets/vorher.png"
                      },
                      "alt": {
                        "type": "string",
                        "maxLength": 300,
                        "description": "What the image shows. Empty string only for purely decorative images."
                      },
                      "caption": {
                        "type": "string",
                        "maxLength": 300
                      }
                    },
                    "required": [
                      "src",
                      "alt"
                    ],
                    "additionalProperties": false
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160,
                    "description": "Accessible name of the video."
                  }
                },
                "required": [
                  "src",
                  "captions",
                  "title"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "type",
              "body"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{1,47}$",
                "description": "Stable id of the block, unique within the exposé. Tracking keys on it."
              },
              "type": {
                "type": "string",
                "const": "audit"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "intro": {
                "type": "string",
                "maxLength": 800
              },
              "scores": {
                "minItems": 1,
                "maxItems": 8,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 60
                    },
                    "value": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    },
                    "detail": {
                      "type": "string",
                      "maxLength": 300
                    },
                    "source": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200,
                      "description": "Where the number comes from, e.g. 'PageSpeed Insights, mobil, 12.10.2026'. Honest and verifiable (§7.2)."
                    }
                  },
                  "required": [
                    "label",
                    "value",
                    "source"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "id",
              "type",
              "title",
              "scores"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{1,47}$",
                "description": "Stable id of the block, unique within the exposé. Tracking keys on it."
              },
              "type": {
                "type": "string",
                "const": "before_after"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "intro": {
                "type": "string",
                "maxLength": 800
              },
              "before": {
                "type": "object",
                "properties": {
                  "src": {
                    "type": "string",
                    "pattern": "^assets\\/(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._/-]*\\.(png|jpe?g|webp|avif|svg|mp4|webm|vtt)$",
                    "description": "Relative path, e.g. assets/vorher.png"
                  },
                  "alt": {
                    "type": "string",
                    "maxLength": 300,
                    "description": "What the image shows. Empty string only for purely decorative images."
                  },
                  "caption": {
                    "type": "string",
                    "maxLength": 300
                  }
                },
                "required": [
                  "src",
                  "alt"
                ],
                "additionalProperties": false
              },
              "after": {
                "type": "object",
                "properties": {
                  "src": {
                    "type": "string",
                    "pattern": "^assets\\/(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._/-]*\\.(png|jpe?g|webp|avif|svg|mp4|webm|vtt)$",
                    "description": "Relative path, e.g. assets/vorher.png"
                  },
                  "alt": {
                    "type": "string",
                    "maxLength": 300,
                    "description": "What the image shows. Empty string only for purely decorative images."
                  },
                  "caption": {
                    "type": "string",
                    "maxLength": 300
                  }
                },
                "required": [
                  "src",
                  "alt"
                ],
                "additionalProperties": false
              },
              "beforeLabel": {
                "default": "Heute",
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "afterLabel": {
                "default": "Vorschlag",
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              }
            },
            "required": [
              "id",
              "type",
              "title",
              "before",
              "after"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{1,47}$",
                "description": "Stable id of the block, unique within the exposé. Tracking keys on it."
              },
              "type": {
                "type": "string",
                "const": "findings"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "intro": {
                "type": "string",
                "maxLength": 800
              },
              "items": {
                "minItems": 1,
                "maxItems": 12,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "title": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120
                    },
                    "severity": {
                      "default": "medium",
                      "type": "string",
                      "enum": [
                        "high",
                        "medium",
                        "low"
                      ]
                    },
                    "impact": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 600,
                      "description": "What it costs the business today."
                    },
                    "solution": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 600
                    }
                  },
                  "required": [
                    "title",
                    "impact",
                    "solution"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "id",
              "type",
              "title",
              "items"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{1,47}$",
                "description": "Stable id of the block, unique within the exposé. Tracking keys on it."
              },
              "type": {
                "type": "string",
                "const": "proposal"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "intro": {
                "type": "string",
                "maxLength": 800
              },
              "items": {
                "minItems": 1,
                "maxItems": 12,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "title": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 600
                    },
                    "benefit": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300,
                      "description": "The concrete benefit for the prospect."
                    },
                    "icon": {
                      "type": "string",
                      "enum": [
                        "website",
                        "mobile",
                        "search",
                        "map",
                        "social",
                        "brand",
                        "photo",
                        "speed",
                        "calendar",
                        "shop",
                        "mail",
                        "chart"
                      ]
                    }
                  },
                  "required": [
                    "title",
                    "description",
                    "benefit"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "id",
              "type",
              "title",
              "items"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
