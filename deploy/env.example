# Copy to deploy/.env on the server and fill in (docs/DEPLOY.md).
# Secrets: run `pnpm deploy:secrets` on your own machine and paste its lines.

POSTGRES_PASSWORD=
# Production: run released versions instead of every merge (ADR-0057).
# APP_IMAGE=ghcr.io/tsh3rr/aquisiteur:production
# Staging next to production on the same server: own project, port and URL.
# COMPOSE_PROJECT_NAME=aquisiteur-staging
# APP_PORT=8080
APP_URL=https://aquisiteur.mikrus.dev
PLATFORM_DOMAIN=mikrus.dev
SIGNUP_ALLOWLIST=you@example.com
PLATFORM_ADMIN_EMAILS=you@example.com

HOSTING_PROFILE=node
HOSTING_PLAN=vps
EMAIL_PROVIDER=log
ALLOW_LOG_EMAIL=1
# Invoices by e-mail need a real provider (docs/DEPLOY.md, "Für den echten Betrieb"):
# EMAIL_PROVIDER=resend
# EMAIL_FROM="Aquisiteur <rechnung@mail.example.com>"
# RESEND_API_KEY=
# RESEND_WEBHOOK_SECRET=
REALTIME_PROVIDER=memory
PUSH_PROVIDER=webpush
VAPID_SUBJECT=mailto:you@example.com
GEOCODER_CONTACT=you@example.com

BETTER_AUTH_SECRET=
INTEGRATIONS_ENCRYPTION_KEY=
CRON_SECRET=
# Only behind Cloudflare with the Transform Rule from docs/SECURITY.md, else leave empty.
ORIGIN_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
