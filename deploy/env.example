# Copy to deploy/.env on the server and fill in (docs/DEPLOY_COMPOSE.md).
# Secrets: run `pnpm deploy:secrets` on your own machine and paste its lines.

POSTGRES_PASSWORD=
# Production server only: run released versions instead of every merge (ADR-0057).
# APP_IMAGE=ghcr.io/tsh3rr/aquisiteur:production
APP_URL=https://aquisiteur.mikrus.dev
PLATFORM_DOMAIN=mikrus.dev
SIGNUP_ALLOWLIST=you@example.com
PLATFORM_ADMIN_EMAILS=you@example.com

HOSTING_PROFILE=node
HOSTING_PLAN=vps
EMAIL_PROVIDER=log
ALLOW_LOG_EMAIL=1
REALTIME_PROVIDER=memory
PUSH_PROVIDER=webpush
VAPID_SUBJECT=mailto:you@example.com
GEOCODER_CONTACT=you@example.com

BETTER_AUTH_SECRET=
INTEGRATIONS_ENCRYPTION_KEY=
CRON_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
